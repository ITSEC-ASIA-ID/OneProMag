# Caddy in front of the app: TLS, compression, security headers, access log.
#
# DOMAIN is set by docker-compose.prod.yml. Two shapes:
#   DOMAIN=onepromag.example.com   -> Caddy fetches a Let's Encrypt certificate
#                                     (needs 80 and 443 reachable, DNS pointing
#                                     here, and ACME_EMAIL set)
#   DOMAIN=:80                     -> plain http on port 80, for a LAN install
#                                     addressed by IP. Pair it with
#                                     COOKIE_SECURE=0, since there is no TLS to
#                                     attach a Secure cookie to.

{$DOMAIN} {
	encode zstd gzip

	header {
		# One year, and keep it: this host is https-only from now on.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Do not advertise the server.
		-Server
	}

	# The app reads at most 512 KB per request and the import dialog sends text,
	# so anything larger is either a mistake or an attempt.
	request_body {
		max_size 2MB
	}

	# /healthz is the app's own readiness probe (it pings Postgres). Exposed
	# unauthenticated on purpose: monitoring needs it, and it returns nothing
	# but a boolean plus an uptime counter.
	reverse_proxy onepromag:3131 {
		# Keep-alive to the app; the app is a single node process, so a longer
		# queue here is safer than opening connections per request.
		health_uri /healthz
		health_interval 30s
		health_timeout 6s
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# OneProMag — production settings.
#
# EVERYTHING HERE IS OPTIONAL.
# `docker compose -f docker-compose.prod.yml up -d --build` runs with no .env at
# all: the app on http://localhost:3131, backed by Postgres, with the container
# hardening on. This file exists for the two things a default cannot invent —
# TLS (needs a hostname) and a password that is not the shipped default.
#
# Copy to the project root as `.env` (git-ignored) when you want them.

# ---- TLS (profile: tls) ----------------------------------------------------
# A hostname that resolves to this machine, e.g. onepromag.example.com.
# Setting it is what lets Caddy request a certificate:
#   docker compose -f docker-compose.prod.yml --profile tls up -d --build
#DOMAIN=onepromag.example.com
#ACME_EMAIL=you@example.com
# With a proxy in front, the app itself should not be reachable from outside:
#APP_BIND=127.0.0.1
# Leave COOKIE_SECURE unset and the cookie follows the request: `Secure` over
# https, not over http. Override only if the TLS terminator does not send
# X-Forwarded-Proto.
#COOKIE_SECURE=1

# ---- First admin (only used while the users table is empty) -----------------
# The production file seeds NO demo data: it creates one admin and stops there.
# Leave these unset and the password is generated and printed once in the boot
# log (docker compose -f docker-compose.prod.yml logs onepromag).
#ADMIN_USERNAME=admin
#ADMIN_NAME=Administrator
#ADMIN_PASSWORD=<openssl rand -base64 18>
# Set to 1 only for a throwaway demo box that should have the fixtures.
#SEED_DEMO=0
# Public self-registration. Off by default in the production file: accounts are
# created in Admin panel → Manage users, or imported there.
#ALLOW_REGISTER=0

# ---- Database --------------------------------------------------------------
# CHANGE ME for anything on a network: the app prints a warning in its boot log
# while this is still the default.
#POSTGRES_PASSWORD=<openssl rand -base64 24>
#POSTGRES_DB=onepromag
#POSTGRES_USER=onepromag

# ---- Backup profile --------------------------------------------------------
#mkdir -p backups   (do this first, owned by you)
#HOST_UID=1000      (id -u)
#HOST_GID=1000      (id -g)
#BACKUP_INTERVAL_SECONDS=86400
#BACKUP_KEEP_DAYS=14

# ---- Misc ------------------------------------------------------------------
#TZ=Asia/Jakarta
#ONEPROMAG_SUBNET=10.77.0.0/24

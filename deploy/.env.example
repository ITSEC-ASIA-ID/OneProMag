# OneProMag — production settings.
#
# Copy to the project root as `.env` (it is git-ignored), fill in the three
# values marked CHANGE ME, then:
#
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Compose refuses to start while POSTGRES_PASSWORD is unset or empty — that is
# deliberate: a database that silently comes up with the password "onepromag"
# is worse than one that does not come up at all.

# ---- TLS -------------------------------------------------------------------
# A hostname reachable by the browser, e.g. onepromag.example.com.
# Use `:80` for a LAN install with no certificate (then set COOKIE_SECURE=0).
DOMAIN=:80

# Needed only for a real domain: Let's Encrypt uses it for expiry notices.
ACME_EMAIL=

# 1 = the session cookie carries `Secure`. Requires https:// in front.
# 0 = plain http (LAN install); the cookie is then sent over the wire in clear.
COOKIE_SECURE=0

# ---- Database --------------------------------------------------------------
POSTGRES_DB=onepromag
POSTGRES_USER=onepromag
# CHANGE ME: generate with  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Backups (profile: backup) --------------------------------------------
# Seconds between dumps, and how many days of them to keep.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# ---- Locale / network ------------------------------------------------------
# Used for the automatic start/end date stamps and the backup filenames.
TZ=Asia/Jakarta
# Change if 10.77.0.0/24 collides with your own network.
ONEPROMAG_SUBNET=10.77.0.0/24
